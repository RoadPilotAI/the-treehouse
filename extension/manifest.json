{
  "manifest_version": 3,
  "name": "Treehouse — Manual Transport Prototype",
  "version": "0.3.0",
  "description": "Experimental user-authorized one-seed actuation; no autonomous reply relay.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Treehouse bounded handshake",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "adapters/chatgpt.js",
        "observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "adapters/gemini.js",
        "observer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
